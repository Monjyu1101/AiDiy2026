# Runtime config (local only)
# _config directories may exist, but their real contents must not be synced.
**/_config/*
!**/_config/.gitkeep
!**/_config/.gitignore
!**/_config/README.md
!**/_config/*.example.json
!**/_config/*.sample.json
!**/_config/*.template.json

# Logs & temp
*.log
logs/
# 一時フォルダは全階層で除外する（末尾 / はディレクトリだけに一致）。
temp/
_temp/
.temp/
# 試験用の作業フォルダも全階層で除外する（tests/ などの正式なテストは対象外）。
test/
_test/
.test/
_work/
_log/

