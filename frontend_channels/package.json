{
  "name": "aidiy-discord",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node panel/launch.mjs",
    "bot": "tsx src/main.ts",
    "config:check": "tsx src/main.ts --check",
    "check": "tsc --noEmit && node scripts/verify-panel.mjs",
    "test": "tsx --test checks/*.test.ts",
    "build:panel": "node scripts/build-panel.mjs",
    "check:panel": "node scripts/verify-panel.mjs",
    "check:lock": "node scripts/verify-lock.mjs",
    "update:electron": "node scripts/update-electron.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@discordjs/ws": "1.2.3",
    "agent-base": "7.1.4",
    "discord.js": "14.27.0",
    "https-proxy-agent": "7.0.6",
    "opusscript": "0.1.1",
    "tsx": "4.23.15",
    "undici": "6.29.0",
    "ws": "^8.19.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.7.0",
    "typescript": "^5.9.0",
    "@vue/compiler-sfc": "3.5.43",
    "esbuild": "0.28.2",
    "happy-dom": "20.8.4",
    "semver": "7.8.5"
  }
}
